# ---------------------------------------------------------------------------
# XforceMsw environment configuration
# Copy to .env.local for local development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Secret used to derive session lookups. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# SQLite database file. On Railway with a volume, point this at the mount, e.g. /data/xforcemsw.db
DATABASE_PATH=./data/xforcemsw.db

# Where uploaded sources and generated artifacts are written.
STORAGE_DIR=./data/storage

# Public site URL, used for metadata. No trailing slash.
APP_URL=http://localhost:3000

# Comma-separated emails that get the admin role on registration.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Conversion engine (your tool)
# ---------------------------------------------------------------------------
# When set, conversions are POSTed to {MSW_ENGINE_URL}/convert.
# When unset, the platform runs in stub mode: uploads are accepted and recorded,
# but the conversion step fails with "engine not connected".
MSW_ENGINE_URL=
MSW_ENGINE_TOKEN=

# Milliseconds before an engine call is aborted. Default 120000.
MSW_ENGINE_TIMEOUT_MS=120000
