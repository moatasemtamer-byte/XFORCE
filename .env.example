# ---------------------------------------------------------------------------
# XforceMsw environment configuration
# Copy to .env.local for local development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Secret used to derive session lookups. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# SQLite database file. On Railway with a volume, point this at the mount, e.g. /data/xforcemsw.db
DATABASE_PATH=./data/xforcemsw.db

# Where uploaded sources and generated artifacts are written.
STORAGE_DIR=./data/storage

# Public site URL, used for metadata. No trailing slash.
APP_URL=http://localhost:3000

# Comma-separated emails that get the admin role on registration.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Conversion engine (Triconex XML -> TIA Portal package)
# ---------------------------------------------------------------------------
# The engine under ./engine (C#, .NET 7) is POSTed to at {MSW_ENGINE_URL}/convert.
# Start it locally with:
#   dotnet engine\src\TriconexToTia.Server\bin\Debug\net7.0\TriconexToTia.Server.dll
# then point MSW_ENGINE_URL at it (default below).
#
# When unset, the platform runs in stub mode: uploads are accepted and recorded,
# but the conversion step fails with "engine not connected".
MSW_ENGINE_URL=http://localhost:5080
MSW_ENGINE_TOKEN=

# Milliseconds before an engine call is aborted. Default 120000.
MSW_ENGINE_TIMEOUT_MS=120000

# Evidence directories read by the /engine dashboard (GET /api/status,
# /api/evidence/*). MSW_OUTPUT_DIR holds report.json + roundtrip.json;
# MSW_STATUS_DIR holds tests.trx (defaults to <MSW_OUTPUT_DIR>/status).
# Forwarded to the engine as query params; the engine also reads these names
# from its own environment, so this is only needed when the frontend and engine
# run on different machines.
#
# When the ENGINE has MSW_OUTPUT_DIR set, every successful conversion rewrites
# report.json and conversion_report.txt (plus the stage reports) there, so the
# dashboard has something to show on a host that keeps no work directory. Point
# it at a mounted volume to survive restarts. Unset, the engine keeps nothing.
# roundtrip.json only appears after a TIA Portal import (Windows, import.ps1)
# and tests.trx only after tools/Run-Tests.ps1, so both stay empty on a hosted
# Linux engine.
#
# The engine also appends one line per conversion to history.jsonl there
# (GET /api/history) and prunes it, plus stale evidence files, on every write:
# MSW_HISTORY_RETENTION_DAYS keeps history lines (default 14),
# MSW_EVIDENCE_RETENTION_DAYS deletes report files older than that (default 14).
MSW_OUTPUT_DIR=
MSW_STATUS_DIR=
# MSW_HISTORY_RETENTION_DAYS=14
# MSW_EVIDENCE_RETENTION_DAYS=14

# Optional. The engine also honours these names when MSW_ENGINE_* are unset.
# XFORCEMSW_ENGINE_TOKEN=
# PORT=5080
# MSW_MAX_UPLOAD_BYTES=536870912

# Milliseconds before POST /convert/project (build a real .ap16 with TIA Portal)
# is aborted. The Openness import runs for minutes, so the default is much
# larger than MSW_ENGINE_TIMEOUT_MS. Default 2700000 (45 minutes).
MSW_ENGINE_PROJECT_TIMEOUT_MS=2700000

# ---------------------------------------------------------------------------
# Engine host: building an openable TIA project (POST /convert/project)
# ---------------------------------------------------------------------------
# These are read by the ENGINE, not the web app, and only matter on a Windows
# host that has TIA Portal installed. Driving TIA needs the Siemens Openness
# API; the hosted (Linux) engine cannot build projects and answers /health with
# tiaImport.available=false.
#
# MSW_TIA_INSTALL_PATH   TIA Portal install root. Default:
#                        C:\Program Files\Siemens\Automation\Portal V16
# MSW_TIA_CPU_ORDER_NUMBER  CPU order number to add before importing. When
#                        empty the CPU order number supplied per request (the
#                        "CPU order number" field) is used; if neither is set
#                        the project would be empty, so the request is rejected.
# MSW_TIA_PROJECTS_DIR   Optional. Parent directory for the temporary project
#                        (defaults to a temp folder, deleted afterwards).
# MSW_TIA_INSTALL_PATH=
# MSW_TIA_CPU_ORDER_NUMBER=
# MSW_TIA_PROJECTS_DIR=

# ---------------------------------------------------------------------------
# Engine host: the ladder pipeline (PDF/LPT -> equations -> TriStation XML)
# ---------------------------------------------------------------------------
# These are read by the ENGINE, not the web app. POST /convert now accepts a
# ladder-logic PDF (.pdf) or a TRISTATION listing (.lpt) instead of an XML export.
# The upload can carry an optional "dpt" file (the Triconex tag dictionary) and an
# optional "template" file (the safety template library); when they are absent the
# engine falls back to the defaults below or, for the DPT, runs logic-only. The logic
# builds without a DPT (operand types are inferred from the equations); the DPT only
# adds tag/hardware annotations. Windows-only: both stages are .NET Framework tool
# processes run out-of-process.
#
# MSW_DPT_PATH              Default DPT dictionary when the request omits one.
#                           Optional: with no DPT a ladder upload still converts.
# MSW_LADDER_TEMPLATE_PATH  Default safety template library (.xml/.PT2). When
#                           unset the wrapper uses the blank set bundled beside it.
# MSW_CIRCUITREADER_PATH    circuit-reader.exe (PDF -> TRISTATION listing).
# MSW_LADDERCLI_PATH        BlLadderCli.exe ([DPT +] LPT/XLSX -> TriStation PLCopen XML).
# MSW_LADDER_TIMEOUT_MINUTES  Budget per stage. Default 30 (real programs can take several minutes).
# MSW_DPT_PATH=
# MSW_LADDER_TEMPLATE_PATH=
# MSW_CIRCUITREADER_PATH=
# MSW_LADDERCLI_PATH=

# ---------------------------------------------------------------------------
# Checkout (mock payment provider)
# ---------------------------------------------------------------------------
# Checkout is DISABLED unless this is set. When it is set, the value is the
# access code a visitor must type on /checkout before a license is generated.
# No card is collected and no network call is made: the license is issued
# immediately and is genuinely usable, it is simply not paid for.
#
# Leave this UNSET in production. Anyone holding the code can mint a real
# license for free, so only set it on a demo deployment you are willing to give
# away, and rotate it freely by changing the value.
MOCK_BILLING_TOKEN=

