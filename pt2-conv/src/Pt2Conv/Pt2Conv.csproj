<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pt2Conv</RootNamespace>
    <AssemblyName>pt2conv</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\base.pt2x.gz" LogicalName="Pt2Conv.Resources.base.pt2x.gz" />
    <EmbeddedResource Include="Resources\library_snapshots.json" LogicalName="Pt2Conv.Resources.library_snapshots.json" />
    <EmbeddedResource Include="Resources\hw_module_defaults.json" LogicalName="Pt2Conv.Resources.hw_module_defaults.json" />
    <EmbeddedResource Include="Resources\hw_board_catalog.json" LogicalName="Pt2Conv.Resources.hw_board_catalog.json" />
    <EmbeddedResource Include="Resources\lib_*.ole.gz" LogicalName="Pt2Conv.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\reports\*.trdp" LogicalName="Pt2Conv.Resources.reports.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
  </ItemGroup>

</Project>