<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SessionContinue - standalone Windows GUI that clones an OpenCode session so work
    continues seamlessly: pick a session, it is exported to JSON, re-imported under a
    new id titled "<name> 2" (then 3, ...), and shows up at the top of the OpenCode
    session list with its full history intact.

    Windows-only (WinForms). Talks to OpenCode only through the public CLI
    (opencode session list/export/import), no private files are touched.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SessionContinue</AssemblyName>
    <RootNamespace>SessionContinue</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Description>Continue an OpenCode session as a numbered clone</Description>
  </PropertyGroup>

</Project>
